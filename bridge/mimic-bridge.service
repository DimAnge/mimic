[Unit]
Description=Mimic bridge - serves system, calendar, music and usage data to the Pico W
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust both paths: the virtualenv, and wherever you cloned the repository.
ExecStart=%h/desky-venv/bin/python %h/projects/mimic/bridge/bridge.py
WorkingDirectory=%h/projects/mimic/bridge
Restart=on-failure
RestartSec=5
# The bridge holds the tokens, so keep it to the local network.
Environment=MIMIC_BIND=0.0.0.0
Environment=MIMIC_PORT=8080

[Install]
WantedBy=default.target
